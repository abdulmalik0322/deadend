# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000

# Local MongoDB for development.
MONGODB_URI=mongodb://localhost:27017/deadend
# Production: use a MongoDB Atlas URI, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deadend?retryWrites=true&w=majority

# JWT signing secret. Generate 64+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be identical across all server instances.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:5173

# SMTP for transactional email (password-reset). All four are required;
# when missing, POST /api/auth/forgot-password returns 503 email_not_configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bootstrap-only setup endpoints (/api/setup/seed, /api/setup/promote).
# Requests must carry this exact value in the `x-setup-key` header.
# When unset, the setup routes are disabled (404). Use a long random string.
SETUP_KEY=

# Environment: development | production.
# In production, CORS denies requests when CLIENT_URL is unset.
NODE_ENV=development

# Rate limiting (shared defaults; see middleware/rateLimit.js).
# RATE_LIMIT_MAX overrides the default 300 requests per 15-minute window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
